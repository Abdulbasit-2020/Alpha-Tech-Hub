rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function validUserProfile(userId) {
      return request.resource.data.keys().hasOnly(['uid','fullName','name','email','photoURL','createdAt','emailVerified']) &&
        request.resource.data.uid == userId;
    }
    function validServiceRequest() {
      return request.resource.data.keys().hasOnly(['name','email','phone','service','budget','message','status','createdAt','submittedBy','source']) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 200 &&
        request.resource.data.message is string && request.resource.data.message.size() <= 3000;
    }
    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == userId && validUserProfile(userId));
      allow delete: if isAdmin();
    }
    match /clients/{clientId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /projects/{projectId} {
      allow read: if isAdmin() || (signedIn() && resource.data.clientUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /serviceRequests/{requestId} {
      allow read, update, delete: if isAdmin();
      allow create: if validServiceRequest();
    }
    match /payments/{paymentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.clientUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
    match /messages/{messageId} {
      allow read, write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}